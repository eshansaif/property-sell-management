// ============================================================
// PRISMA SCHEMA — Service & Listing Lead Management Platform
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH / RBAC
// ------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          RoleName  @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]        @relation("ListingOwner")
  assignedLeads Inquiry[]        @relation("InquiryAssignee")
  notes         InquiryNote[]
  activities    InquiryActivity[]
  auditLogs     AuditLog[]

  @@index([email])
}

// ------------------------------------------------------------
// CATALOG: SERVICE -> SUBSERVICE -> LISTING
// ------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Service {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  shortDesc   String?
  description String?
  icon        String?
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  displayOrder Int          @default(0)
  isFeatured  Boolean       @default(false)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subServices SubService[]
  listings    Listing[]
  specs       Specification[]

  @@index([status, displayOrder])
}

model SubService {
  id          String        @id @default(cuid())
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  shortDesc   String?
  description String?
  icon        String?
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  displayOrder Int          @default(0)
  isFeatured  Boolean       @default(false)

  seoTitle       String?
  seoDescription String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  listings    Listing[]
  specs       Specification[]

  @@unique([serviceId, slug])
  @@index([status, displayOrder])
}

// ------------------------------------------------------------
// DYNAMIC SPECIFICATIONS (attribute system)
// ------------------------------------------------------------

enum SpecFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  CURRENCY
  MEASUREMENT
}

// A specification is DEFINED at the Service or SubService level,
// so every listing under that category gets a consistent, but
// still fully admin-configurable, set of fields. Nothing about
// "bedrooms" or "katha" is hardcoded in the schema.
model Specification {
  id           String        @id @default(cuid())
  serviceId    String?
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subServiceId String?
  subService   SubService?   @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  name         String
  key          String        // machine key, e.g. "bedrooms"
  type         SpecFieldType @default(TEXT)
  unit         String?       // e.g. "sqft", "katha", "BDT"
  options      String[]      @default([]) // for SELECT / MULTI_SELECT
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(false)
  displayOrder Int           @default(0)

  values       ListingSpecificationValue[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([subServiceId, key])
  @@index([serviceId])
}

model ListingSpecificationValue {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  value           String        // stored as string; parsed/typed on read by `type`

  @@unique([listingId, specificationId])
  @@index([specificationId, value])
}

// ------------------------------------------------------------
// LISTINGS
// ------------------------------------------------------------

model Listing {
  id            String        @id @default(cuid())
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subServiceId  String
  subService    SubService    @relation(fields: [subServiceId], references: [id], onDelete: Restrict)
  ownerId       String?
  owner         User?         @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  title         String
  slug          String        @unique
  shortDesc     String?
  description   String?
  priceLabel    String?       // free-text: "৳45,00,000", "Negotiable", "Contact for price"
  location      String?

  status        ContentStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  publishedAt   DateTime?

  seoTitle       String?
  seoDescription String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  images        ListingImage[]
  specs         ListingSpecificationValue[]
  customSpecs   ListingCustomSpec[]
  inquiries     Inquiry[]

  @@index([serviceId, subServiceId, status])
  @@index([status, isFeatured, publishedAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, sortOrder])
}

// ------------------------------------------------------------
// INQUIRIES (LEADS)
// ------------------------------------------------------------

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  FOLLOW_UP
  CONVERTED
  CLOSED
  REJECTED
}

model Inquiry {
  id            String        @id @default(cuid())

  // context — auto-filled from the page the inquiry came from
  serviceId     String?
  subServiceId  String?
  listingId     String?
  listing       Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)

  name          String
  phone         String
  email         String?
  message       String
  preferredContact String?

  sourcePage    String?
  referrer      String?
  ipAddress     String?
  userAgent     String?

  status        InquiryStatus @default(NEW)
  assigneeId    String?
  assignee      User?         @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  notes         InquiryNote[]
  activities    InquiryActivity[]

  @@index([status, createdAt])
  @@index([listingId])
  @@index([phone])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryActivity {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String   // e.g. "CREATED", "STATUS_CHANGED", "ASSIGNED", "NOTE_ADDED"
  detail    String?
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

// ------------------------------------------------------------
// SYSTEM
// ------------------------------------------------------------

model SystemSetting {
  key   String @id
  value String
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String
  previous   String?
  next       String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// FREE-FORM PER-LISTING SPECIFICATIONS
// Lets an editor add any number of "Label: Value" rows directly inside
// a listing (optionally grouped under a section title), with no
// pre-defined Specification needed. Complements the definition-based
// Specification system (which is best for filterable, consistent fields).
// ------------------------------------------------------------
model ListingCustomSpec {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  group     String  @default("")
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([listingId, sortOrder])
}
